<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <AssemblyName>MuSync</AssemblyName>
        <RootNamespace>MuSync</RootNamespace>

        <!-- 看门狗自愈验证开关：仅显式传 -p:MuSyncStallTest=true 时定义；常规构建与所有发布产物都不定义，
             因此产物内不含卡死注入钩子（行为零变化）。用途：在 Release 配置下验证自愈路径。 -->
        <DefineConstants Condition="'$(MuSyncStallTest)' == 'true'">$(DefineConstants);MUSYNC_STALL_TEST</DefineConstants>

        <!-- 看门狗诊断构建开关：仅显式传 -p:MuSyncNoWatchdog=true 时定义；常规构建与所有发布产物都不定义。
             用途：卡死取证——停摆时看门狗仍然检测并记录，但**不重启主循环**，把「卡住的现场」保留下来，
             便于用任务管理器「创建转储文件」取证，再交给 dotnet-dump analyze 定位。
             仅供排查使用，不可作为日常版本分发（失去自愈能力）。 -->
        <DefineConstants Condition="'$(MuSyncNoWatchdog)' == 'true'">$(DefineConstants);MUSYNC_NO_WATCHDOG_RESTART</DefineConstants>


        <Version>0.4.3</Version>
        <!-- 发行形态：full=自包含完整版；lite=框架依赖版（发布时 SelfContained=false 自动标记，也可 -p:MuSyncEdition= 显式指定） -->
        <MuSyncEdition Condition="'$(MuSyncEdition)' == '' and '$(SelfContained)' == 'false'">lite</MuSyncEdition>
        <MuSyncEdition Condition="'$(MuSyncEdition)' == ''">full</MuSyncEdition>
        <Description>MuSync - 把音乐与程序状态同步到 Steam</Description>



        <PlatformTarget>x64</PlatformTarget>
        <UseWindowsForms>true</UseWindowsForms>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <ApplicationIcon>Resources\icon.ico</ApplicationIcon>

        <Product>MuSync</Product>
        <Title>MuSync</Title>
        <Company>ZhaoBuyan</Company>
        <Copyright>Copyright (c) 2026 ZhaoBuyan</Copyright>
        <Authors>ZhaoBuyan</Authors>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>embedded</DebugType>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>embedded</DebugType>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    </PropertyGroup>

    <ItemGroup>

        <PackageReference Include="SteamKit2" Version="3.4.0" />

        <!-- Microsoft.Win32.Registry / System.Security.*（Cryptography.ProtectedData、AccessControl、
             Principal.Windows）自 .NET 10 起由 Windows 目标框架自带。显式引用会触发 NU1510
             （「此包自动可用，无需显式引用」），而本项目 TreatWarningsAsErrors=True 会直接编译失败。 -->
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\icon.ico">
            <LogicalName>MuSync.Resources.icon.ico</LogicalName>
        </EmbeddedResource>
        <!-- 许可文本内嵌（单文件 exe 也随得走）：内容就是仓库根目录的这几份，构建时同步 -->
        <EmbeddedResource Include="LICENSE" LogicalName="MuSync.Licenses.LICENSE" />
        <EmbeddedResource Include="THIRD-PARTY-NOTICES.md" LogicalName="MuSync.Licenses.THIRD-PARTY-NOTICES" />
        <EmbeddedResource Include="licenses\LGPL-2.1.txt" LogicalName="MuSync.Licenses.LGPL-2.1" />
    </ItemGroup>

    <!-- reference-yySync 仅为对照参考，不参与编译 -->
    <ItemGroup>
        <Compile Remove="reference-yySync\**\*.cs" />
        <None Remove="reference-yySync\**" />
        <Compile Remove="tests\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MuSync.Tests" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyMetadata Include="MuSyncEdition" Value="$(MuSyncEdition)" />
    </ItemGroup>

</Project>
