{
  "manifest_version": 3,
  "name": "MuSync Browser Bridge",
  "version": "1.2.0",
  "description": "把浏览器里正在播放的媒体上报给 MuSync（只发到本机 127.0.0.1，不联网）。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MuSync 浏览器桥（点击打开设置）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": ["http://127.0.0.1/*"],
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
